mixin profile-center(props)
  div.profile-center
    div.profile-center__top 
      h2.profile-center__title=props.title 
      if props.select
        select(name="profile").profile-center__select
          option(value="0") Все заказы
          option(value="1") Заказ на физ. лицо
          option(value="2") ООО Еще одна организация
          option(value="3") ООО Еще одна организация с длинным названием
          option(value="4") Digital-агентство 5 УГЛОВ
    div.profile-center__main

      if props.sort
        +top-filters({})

      if props.list
        div.profile-center__list
          +item-card({
            front: './assets/images/promo-picture-1.png',
            back: './assets/images/item-background-1.jpg',
            tags: true,
            flag: './assets/images/item-flag-1.jpg',
            title: 'Хмель шишковой улучшенный свежий выращенный самыми лучшими специалистами',
            pricePack: true,
          })
          +item-card({
            front: './assets/images/promo-picture-2.png',
            back: './assets/images/item-background-2.jpg',
            flag: './assets/images/item-flag-2.jpg',
            title: 'Солод шишковой',
            pricePack: true,
          })
          +item-card({
            front: './assets/images/promo-picture-3.png',
            back: './assets/images/item-background-1.jpg',
            mixin: 'item-card--to-order',
            flag: './assets/images/item-flag-3.jpg',
            title: 'Семечко хмеля Емеля',
          })
          +item-card({
            front: './assets/images/promo-picture-4.png',
            flag: './assets/images/item-flag-1.jpg',
            tags: true,
            title: 'Мешок белого цемента',
          })
          +item-card({
            front: './assets/images/promo-picture-5.png',
            back: './assets/images/item-background-2.jpg',
            tags: true,
            flag: './assets/images/item-flag-1.jpg',
            title: 'Модная импортная продукция, которую никогда не увидим больше',
          })
          +item-card({
            front: './assets/images/promo-picture-6.png',
            back: './assets/images/item-background-1.jpg',
            tags: true,
            flag: './assets/images/item-flag-3.jpg',
            title: 'Просто бочка',
          })
          +item-card({
            front: './assets/images/promo-picture-1.png',
            back: './assets/images/item-background-1.jpg',
            tags: true,
            flag: './assets/images/item-flag-1.jpg',
            title: 'Хмель шишковой улучшенный свежий выращенный самыми лучшими специалистами',
          })
          +item-card({
            front: './assets/images/promo-picture-2.png',
            back: './assets/images/item-background-2.jpg',
            flag: './assets/images/item-flag-1.jpg',
            title: 'Солод шишковой',
          })
          +item-card({
            front: './assets/images/promo-picture-3.png',
            back: './assets/images/item-background-1.jpg',
            flag: './assets/images/item-flag-2.jpg',
            title: 'Семечко хмеля Емеля',
          })
          +item-card({
            front: './assets/images/promo-picture-4.png',
            flag: './assets/images/item-flag-1.jpg',
            title: 'Мешок цемента',
          })
          +item-card({
            front: './assets/images/promo-picture-5.png',
            back: './assets/images/item-background-2.jpg',
            flag: './assets/images/item-flag-3.jpg',
            title: 'Модная продукция',
          })
          +item-card({
            front: './assets/images/promo-picture-6.png',
            back: './assets/images/item-background-1.jpg',
            flag: './assets/images/item-flag-1.jpg',
            title: 'Просто бочка',
          })

      block

      if props.pagination
        include ../pagination/pagination
