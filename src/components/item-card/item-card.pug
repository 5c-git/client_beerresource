            tr
              td Артикул:
              td 168457
            tr
              td Цветность:
              td 1300 EBC
            tr
              td Тип:
              td Базовый солод


  else if props.compare
    article.item-card
      a(href="#").item-card__banner 
        div.item-card__banner-front
          <!-- Рекомендованые размеры 164х164 -->
          if props.front
            img(src=props.front, alt="")
        div.item-card__banner-back
          <!-- Тут может не быть изображения -->
          if props.back
            img(src=props.back, alt="")
      div.item-card__content 
        if props.tags
          ul.item-card__tags 
            li.item-card__tag.item-card__tag--red Скидка
            li.item-card__tag.item-card__tag--orange Хит продаж
            li.item-card__tag.item-card__tag--green Новинка
        div.item-card__header
          img(src=props.flag, alt="").item-card__flag
          span.item-card__flag-name Crisp malt
        a(href="#").item-card__title=props.title
        div.item-card__footer
          p.item-card__price
            span.item-card__price-value.item-card__price-value--kg 80.18 ₽ / кг
            if props.pricePack
              span.item-card__price-value.item-card__price-value--pack 2004.5 ₽ / уп


  else if props.onepackag
