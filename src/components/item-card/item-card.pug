mixin item-card(props)
  if props.cart
    article.item-card.item-card--cart
      button(type='button').item-card__delete
        span
      a(href="#").item-card__banner 
        div.item-card__banner-front
          <!-- Рекомендованые размеры 164х164 -->
          if props.front
            img(src=props.front, alt="")
        div.item-card__banner-back
          <!-- Тут может не быть изображения -->
          if props.back
            img(src=props.back, alt="")
      div.item-card__content
        div.item-card__hidden 
          +packaging({
            cart: true,
          })
        div.item-card__header
          img(src=props.flag, alt="").item-card__flag
          span.item-card__flag-name Crisp malt
        a(href="#").item-card__title=props.title
        div.item-card__description
          div.item-card__description-tile
            p 1300 EBC
          table(width="100%" cellspacing="0" cellpadding="0" border="0").item-card__description-table
            tr
              td Артикул:
              td 168457
            tr
              td Цветность:
              td 1300 EBC
            tr
              td Тип:
              td Базовый солод


  else if props.cart2
    article.item-card.item-card--cart
      button(type='button').item-card__delete
        span
      a(href="#").item-card__banner 
        div.item-card__banner-front
          <!-- Рекомендованые размеры 164х164 -->
          if props.front
            img(src=props.front, alt="")
        div.item-card__banner-back
