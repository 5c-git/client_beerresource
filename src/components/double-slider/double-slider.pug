          li.swiper-slide.double-slider__main-item
            div.double-slider__main-banner
              img(src="./assets/images/promo-picture-10.jpg" alt="")
          li.swiper-slide.double-slider__main-item
            div.double-slider__main-banner
              img(src="./assets/images/promo-picture-11.jpg" alt="")
          li.swiper-slide.double-slider__main-item
            div.double-slider__main-banner
              img(src="./assets/images/promo-picture-12.jpg" alt="")
        div.double-slider__pagination

      div.double-slider__sidebar
        div.swiper.double-slider__nav
          ul.swiper-wrapper.double-slider__nav-list
            <!-- Рекомендуемые размеры 70х70. -->
