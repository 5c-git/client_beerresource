              img(src="./assets/images/promo-picture-4.png" alt="")
          li.swiper-slide.double-slider__main-item
            div.double-slider__main-banner
              img(src="./assets/images/promo-picture-5.png" alt="")
          li.swiper-slide.double-slider__main-item
            div.double-slider__main-banner
              img(src="./assets/images/promo-picture-6.png" alt="")
          li.swiper-slide.double-slider__main-item
            div.double-slider__main-banner
              img(src="./assets/images/promo-picture-7.jpg" alt="")
