html(lang="ru")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no")
    meta(name="format-detection" content="telephone=no")
    meta(name="theme-color" content="#231f20")

    <link rel="preload" href="./assets/fonts/Inter/Inter-400.woff2" as="font" crossorigin="anonymous">
    <link rel="preload" href="./assets/fonts/Inter/Inter-500.woff2" as="font" crossorigin="anonymous">
    <link rel="preload" href="./assets/fonts/BEERRESOURCE/BEERRESOURCE-Light.woff" as="font" crossorigin="anonymous">
    //- favicons
    <link rel="apple-touch-icon" sizes="76x76" href="./assets/favicons/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="./assets/favicons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="./assets/favicons/favicon-16x16.png">
    <link rel="manifest" href="./assets/favicons/site.webmanifest">
    <link rel="mask-icon" href="./assets/favicons/safari-pinned-tab.svg" color="#5bbad5">
    <link rel="shortcut icon" href="./assets/favicons/favicon.ico">
    <meta name="msapplication-TileColor" content="#2b5797">
    <meta name="msapplication-config" content="./assets/favicon/browserconfig.xml">
    <meta name="theme-color" content="#ffffff">
    //- favicons

    title Beer Resource

    //- место для подключения стилей jquery библиотек
    //- link(href='libsJQ/test.css' rel='stylesheet')

  body
    block mixins
      include ../components/header/header
      include ../components/title/title
      include ../components/alert/alert
      include ../components/video/video
      include ../components/map/map
      include ../components/modal/modal

      include ../components/marker/marker
      include ../components/how-card/how-card
      include ../components/item-card/item-card
      include ../components/catalog-card/catalog-card
      include ../components/layout/layout
      include ../components/layout-header/layout-header
      include ../components/line/line
      include ../components/banner/banner
      include ../components/tooltip/tooltip
      include ../components/watched/watched
      include ../components/article-card/article-card
      include ../components/empty/empty
      include ../components/tabs/tabs
      include ../components/promotion-card/promotion-card
      include ../components/post-title/post-title
      include ../components/sidebar-nav/sidebar-nav
      include ../components/service-card/service-card
      include ../components/article/article
      include ../components/tags/tags
      include ../components/category-card/category-card
      include ../components/advantage-card/advantage-card
      include ../components/team-card/team-card
      include ../components/socials/socials
      include ../components/clear/clear
      include ../components/offer/offer
      include ../components/payment/payment
      include ../components/cart-block/cart-block
      include ../components/cart-card/cart-card
      include ../components/packaging/packaging
      include ../components/profile-page/profile-page
      include ../components/profile-center/profile-center
      include ../components/offer-card/offer-card
      include ../components/top-filters/top-filters

    block header
      +header({
        secondClass: 'header--transparent',
      })
    
    main
      block main

    block footer
      include ../components/footer/footer
      include ../components/up/up
      include ../components/calculator/calculator
      include ../components/widget/widget
    
    include ../components/alert-wrapper/alert-wrapper

    include ../react/providers/common/LoginProvider/LoginProvider

    template#promotion-alert
      include ../components/promotion-alert/promotion-alert

    template#notice
      include ../components/notice/notice

    template#modal--city
      +modal({
        city: true,
      })

    template#modal--notify
      +modal({
        notify: true,
      })

    template#alert--notify
      +alert({
        notify: true,
      })

    template#alert--request
      +alert({
        request: true,
      })

    template#alert--error
      +alert({
        error: true,
      })

    template#alert--subscribe
      +alert({
        subscribe: true,
      })

    template#alert--compare
      +alert({
        compare: true,
      })

    template#alert--discompare
      +alert({
        discompare: true,
      })

    template#modal--discompare
      +modal({
        discompare: true,
      })

    template#alert--like
      +alert({
        like: true,
      })

    template#modal--dislike
      +modal({
        dislike: true,
      })

    template#alert--dislike
      +alert({
        dislike: true,
      })

    template#alert--cart
