        div.double-slider__nav-buttons
          button(type='button' aria-label='Предыдущий слайд.').double-slider__nav-button.double-slider__nav-button--prev ←
          button(type='button' aria-label='Следующий слайд.').double-slider__nav-button.double-slider__nav-button--next →


