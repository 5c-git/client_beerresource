//- Локальные миксины (вынесены из block mixins шаблона)
include ../marker/marker
section.warehouses
  div.container
    +marker({
      title: '● Склады'
    })
    div.warehouses__wrapper
      h2(data-aos='fade-up' data-aos-delay='100' data-aos-duration='500').warehouses__title <em>37 складов</em> в 15 городах России
      div.warehouses__content 
        p.warehouses__text С учётом сложившейся международной обстановки, начало повседневной работы по формированию позиции предполагает независимые способы реализации прогресса профессионального сообщества.
      div.warehouses__map
        include ../warehouses-map/warehouses-map
      div.warehouses__footer
        a(href="#").warehouses__link.button.button--reverse Наша география&nbsp;→