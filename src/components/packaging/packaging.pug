mixin packaging(props)
  if props.cart
    section.packaging
      div.packaging__type 
        span.packaging__type-input Мешок 5 кг
        <!-- Если будет больше 4 пунктов, будут проблемы с вёрсткой. -->
        ul.packaging__type-list 
          li.packaging__type-item Мешок 5 кг
          li.packaging__type-item Мешок 15 кг
          li.packaging__type-item Мешок 25 кг
          li.packaging__type-item Мешок 50 кг
          li.packaging__type-item Мешок 75 кг
          li.packaging__type-item Мешок 150 кг
          
      div.packaging__count
        <!-- Если у товара нет выбора объёма то в в списке будет один пункт с классом '.packaging__count-item--active' по умолчанию. -->
        ul.packaging__count-list 
          li.packaging__count-item.packaging__count-item--active
            div.packaging__count-main
              p.packaging__price 10 000 ₽

              div(data-max='1000000').packaging__count-buttons
                <!-- В дата атрибуте передаём максимально доступное кол-во товара данной упаковки. Для замены логики - писать верстаку. -->
                button(type='button' aria-label='Уменьшить на 1').packaging__count-button.packaging__count-button--minus
                input(type="number" inputmode='numeric' value='1').packaging__count-input
                button(type='button' aria-label='Увеличить на 1').packaging__count-button.packaging__count-button--plus
              p.packaging__total-price 9 220 000 ₽

            span.packaging__count-total 328 * 32 727,27 = 10 734 544,56 т
            
