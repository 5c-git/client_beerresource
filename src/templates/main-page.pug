    template#alert--organization-deleted
      +alert({
        deleted: true,
      })

    template#cookie
      include ../components/cookie/cookie

    template#outdated-browsers
      include ../components/outdated-browsers/outdated-browsers
      


    //- jQuery скрипты
    script(src='libsJQ/jquery.min.js')
    script(src='libsJQ/map-pins.js')
    script(src='libsJQ/warehouses.js')
    block meta