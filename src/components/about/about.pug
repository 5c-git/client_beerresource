//- Локальные миксины (вынесены из block mixins шаблона)
include ../marker/marker
section.about
  div.container 
    +marker({
      title: '● О нас'
    })
    div.about__wrapper
      h2(data-aos='fade-up' data-aos-delay='100' data-aos-duration='500').about__title <em>Beer Resource</em> — поставщик ингредиентов для пивоварения с обширной сетью складов, логистической экспертизой и любовью к пиву. 
      div.about__content 
        p.about__text Мы отвечаем за качество продукта и тратим огромные ресурсы на обеспечение правильного хранения. Сочетаем в работе масштаб и внимание к деталям с 2017 года.
        a(href="#").about__link.button.button--reverse О компании&nbsp;→