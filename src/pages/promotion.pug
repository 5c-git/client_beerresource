extends ../templates/default

block main
  include ../components/breadcrumbs/breadcrumbs
  
  +title({
    title: 'Наименование акции',
  })
    include ../components/back/back

  +layout-header({
    promotion: true,
  })

  +layout({
    sidebar: true,
    title: 'Товары участники',
    promotions: true,
    pagination: true,
  })
    +item-card({
      onepackag: true,
      front: './assets/images/promo-picture-1.png',
      back: './assets/images/item-background-1.jpg',
      tags: true,
      flag: './assets/images/item-flag-1.jpg',
      title: 'Хмель шишковой улучшенный свежий выращенный самыми лучшими специалистами',
      pricePack: true,
    })
    +item-card({
      onepackag: true,
      front: './assets/images/promo-picture-2.png',
      back: './assets/images/item-background-2.jpg',
      flag: './assets/images/item-flag-2.jpg',
      title: 'Солод шишковой',
    })
    +item-card({
      front: './assets/images/promo-picture-3.png',
      back: './assets/images/item-background-1.jpg',
      flag: './assets/images/item-flag-3.jpg',
      title: 'Семечко хмеля Емеля',
    })
    +item-card({
      front: './assets/images/promo-picture-4.png',
      flag: './assets/images/item-flag-1.jpg',
      tags: true,
      title: 'Мешок белого цемента',
      pricePack: true,
    })
    +item-card({
      front: './assets/images/promo-picture-5.png',
      back: './assets/images/item-background-2.jpg',
      tags: true,
      flag: './assets/images/item-flag-1.jpg',
      title: 'Модная импортная продукция, которую никогда не увидим больше',
    })
    +item-card({
      front: './assets/images/promo-picture-6.png',
      back: './assets/images/item-background-1.jpg',
      tags: true,
      flag: './assets/images/item-flag-3.jpg',
      title: 'Просто бочка',
    })
    +item-card({
      front: './assets/images/promo-picture-1.png',
      back: './assets/images/item-background-1.jpg',
      tags: true,
      flag: './assets/images/item-flag-1.jpg',
      title: 'Хмель шишковой улучшенный свежий выращенный самыми лучшими специалистами',
    })
    +item-card({
      front: './assets/images/promo-picture-2.png',
      back: './assets/images/item-background-2.jpg',
      flag: './assets/images/item-flag-1.jpg',
      title: 'Солод шишковой',
    })
    +item-card({
      front: './assets/images/promo-picture-3.png',
      back: './assets/images/item-background-1.jpg',
      flag: './assets/images/item-flag-2.jpg',
      title: 'Семечко хмеля Емеля',
    })
    +item-card({
      front: './assets/images/promo-picture-4.png',
      flag: './assets/images/item-flag-1.jpg',
      title: 'Мешок цемента',
    })
    +item-card({
      front: './assets/images/promo-picture-5.png',
      back: './assets/images/item-background-2.jpg',
      flag: './assets/images/item-flag-3.jpg',
      title: 'Модная продукция',
    })
    +item-card({
      front: './assets/images/promo-picture-6.png',
      back: './assets/images/item-background-1.jpg',
      flag: './assets/images/item-flag-1.jpg',
      title: 'Просто бочка',
    })
  
  +tags({
    title: 'Теги',
  })

  +layout({
    grid3: true,
    title: 'Другие акции',
    link: 'Смотреть все',
  })
    +promotion-card({
      src: './assets/images/image-5.jpg',
      title: 'Финансовый мир очнулся: постоянный количественный рост бодрит',
    })
    +promotion-card({
      src: './assets/images/image-15.jpg',
      title: 'Сложно сказать, почему объем доходов населения сократился',
    })
    +promotion-card({
      src: './assets/images/image-7.jpg',
      title: 'Дурное дело нехитрое: известный инсайдер, в преддверии важного события, не позволил союзу развалиться',
    })
  
  +watched({
    title: 'Вы смотрели',
  })

block append mixins
  include ../components/tags/tags
  include ../components/promotion-card/promotion-card
