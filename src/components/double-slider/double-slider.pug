mixin double-slider(props)

  if props.lots

    div.double-slider
      div.swiper.double-slider__main
        ul.swiper-wrapper.double-slider__main-list
          <!-- Рекомендуемые размеры 330х330. -->
          li.swiper-slide.double-slider__main-item
            div.double-slider__main-banner
              img(src="./assets/images/promo-picture-1.png" alt="")
          li.swiper-slide.double-slider__main-item
            div.double-slider__main-banner
              img(src="./assets/images/promo-picture-2.png" alt="")
          li.swiper-slide.double-slider__main-item
